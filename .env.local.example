# Copie para .env.local e preencha com os valores do seu projeto Supabase
# (Project Settings -> API)

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só usada em rotas de servidor (nunca exposta ao navegador). Necessária
# para a rotina diária de desconto automático.
SUPABASE_SERVICE_ROLE_KEY=

# Qualquer string longa e aleatória — usada para assinar o cookie de "perfil
# ativo" (quem está usando o app agora: André, Hugo, Mãe ou Pai). Gere uma
# com, por exemplo, `openssl rand -hex 32`.
PROFILE_COOKIE_SECRET=

# Outra string longa e aleatória (pode gerar do mesmo jeito). Protege a
# rotina de desconto automático (supabase/cron) para que só o próprio
# Vercel Cron consiga chamá-la — sem ela, qualquer pessoa na internet
# poderia disparar descontos manualmente.
CRON_SECRET=
